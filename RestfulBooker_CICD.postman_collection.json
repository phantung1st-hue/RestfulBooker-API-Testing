                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02_Create_Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\npm.test(\"Tạo booking thành công (Status 200)\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.booking.firstname).to.eql(\"Thanh\");\n});\n\n// Lưu bookingid vào Environment\nvar jsonData = pm.response.json();\npm.environment.set(\"bookingid\", jsonData.bookingid);\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "\n{\n  \"firstname\": \"Thanh\",\n  \"lastname\": \"Tung\",\n  \"totalprice\": 1500,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
