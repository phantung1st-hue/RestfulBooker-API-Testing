        {
          "name": "04_Delete_Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\npm.test(\"Xóa thành công (Status 201 Created)\", function () {\n    pm.response.to.have.status(201);\n});\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
